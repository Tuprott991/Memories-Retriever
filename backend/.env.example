# Backend Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/memories_retriever
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Google Cloud Platform
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_CREDENTIALS_PATH=./flash-spark-467403-r8-167a4e4656aa.json
VERTEX_AI_MODEL=gemini-2.0-flash-exp
VERTEX_AI_LOCATION=us-central1

# Google Cloud Storage
GCS_BUCKET_NAME=memories-retriever-media
GCS_PHOTO_PREFIX=photos/
GCS_VIDEO_PREFIX=videos/
GCS_AUDIO_PREFIX=audio/

# ZEP Memory Graph
ZEP_API_KEY=your-zep-api-key
ZEP_API_URL=https://api.getzep.com
ZEP_SESSION_ID=memories-session

# Neo4j for Graphiti
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=memories

# Local Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# LongMatrix Model
LONGMATRIX_CHECKPOINT_PATH=./finetune/best.pt
LONGMATRIX_CONFIG_PATH=./finetune/config_used.yaml
LONGMATRIX_MAX_LENGTH=512

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048
AGENT_REASONING_ENABLED=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Media Processing
MAX_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp"]
ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".avi",".mkv"]
ALLOWED_AUDIO_EXTENSIONS=[".mp3",".wav",".m4a",".ogg"]
IMAGE_MAX_DIMENSION=2048
VIDEO_THUMBNAIL_TIME=1.0
